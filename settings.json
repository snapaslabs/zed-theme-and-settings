{
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "markdown_preview": {
    "font_family": ".SystemUIFont",
    "code_font_family": ".ZedMono"
  },
  "cli_default_open_behavior": "new_window",
  "lsp_highlight_debounce": 1,
  "diff_view_style": "split",
  "lsp_results_location": "picker",
  "scrollbar": {
    "selected_text": true
  },
  "inlay_hints": {
    "show_value_hints": true,
    "show_parameter_hints": true
  },
  "indent_guides": {
    "enabled": true
  },
  "inline_code_actions": false,
  "gutter": {
    "line_numbers": true,
    "breakpoints": false,
    "folds": false,
    "bookmarks": false,
    "runnables": false
  },
  "git": {
    "inline_blame": {
      "location": "status_bar"
    },
    "git_gutter": "tracked_files",
    "enable_diff": true,
    "enable_status": true
  },
  "buffer_font_weight": 300.0,
  "drag_and_drop_selection": {
    "delay": 100
  },
  "hover_popover_hiding_delay": 100,
  "sticky_scroll": {
    "enabled": true
  },
  "horizontal_scroll_margin": 3.0,
  "use_smartcase_search": true,
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "blinking": "on",
    "cursor_shape": "underline",
    "font_size": 12.0,
    "font_family": "Menlo"
  },
  "proxy": "",
  "code_lens": "off",
  "colorize_brackets": true,
  "prettier": {
    "allowed": true
  },
  "agent": {
    "auto_compact": {
      "threshold": "80%"
    },
    "enable_feedback": false,
    "use_modifier_to_send": true,
    "thinking_display": "always_expanded",
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true
  },
  "ui_font_family": ".SystemUIFont",
  "buffer_font_family": "Menlo",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "status_bar": {
    "experimental.show": true
  },
  "tab_bar": {
    "show": true
  },
  "tabs": {
    "git_status": true
  },
  "minimap": {
    "display_in": "all_editors",
    "show": "always"
  },
  "selection_highlight": true,
  "format_on_save": "on",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Material Icon Theme"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 15.0,
  "buffer_font_size": 13.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "VSCode Smooth High Contrast"
  },
  "languages": {
    "Go": {
      "hard_tabs": true,
      "formatter": { "language_server": { "name": "gopls" } },
      "indent_guides": {
        "coloring": "fixed",
        "enabled": true
      },
      "colorize_brackets": true,
      "inlay_hints": {
        "show_other_hints": false,
        "show_parameter_hints": false,
        "show_type_hints": false,
        "show_value_hints": true,
        "edit_debounce_ms": 100,
        "enabled": true
      }
    },
    "Python": {
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "eslint": {
      "settings": {
        "rulesCustomizations": [{ "rule": "react-hooks/*", "severity": "warn" }]
      }
    }
  }
}
